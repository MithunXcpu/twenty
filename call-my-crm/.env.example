# Copy to call-my-crm/.env. Never commit the filled-in file.
# With these left blank, the add-on uses the offline agent and sample CRM data.

PORT=8787

# auto: NVIDIA when NVIDIA_API_KEY is set, otherwise the offline mock agent.
LLM_PROVIDER=auto
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# auto: Twenty REST when both values are set, otherwise the in-memory sample workspace.
CRM_PROVIDER=auto
TWENTY_API_URL=http://localhost:3000
TWENTY_API_KEY=

# auto: browser Web Speech API, unless a server provider below is selected.
# nvidia posts audio to NVIDIA_BASE_URL/audio/transcriptions (Whisper-compatible).
# whisper posts audio to WHISPER_BASE_URL/audio/transcriptions.
STT_PROVIDER=auto
NVIDIA_ASR_MODEL=openai/whisper-large-v3
WHISPER_BASE_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# browser uses speechSynthesis. elevenlabs and http are optional server voices.
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_HTTP_URL=
TTS_HTTP_API_KEY=

# If set, POST /webhooks/teams must send Authorization: Bearer <secret>
# or the x-call-my-crm-secret header. Empty allows unsigned local calls.
TEAMS_WEBHOOK_SECRET=
